[Unit]
Description=denys post tick (24/7, every ~2-3h randomised)

[Timer]
# Checked every hour, around the clock. The pipeline draws a fresh gap of
# 2h15m-2h50m per tick, so this yields ~9-10 posts a day at irregular times.
# Night hours are not dead time here: measured means were 765 views at 02:00
# UTC and 641 at 04:00, against 103-250 across midday.
OnCalendar=*-*-* *:23:00
# Fire up to 15 min off the scheduled minute.
RandomizedDelaySec=900
Persistent=true
Unit=tala@post-denys.service

[Install]
WantedBy=timers.target
