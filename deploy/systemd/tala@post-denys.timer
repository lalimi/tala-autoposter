[Unit]
Description=denys post tick (hourly; self-throttle gives ~every 3h)

[Timer]
# Checked hourly at :23; run_pipeline(--tick) only posts if >DENYS_MIN_GAP_MINUTES
# since the last post, so the effective cadence is ~3h and a missed hour catches up.
OnCalendar=*-*-* *:23:00
Persistent=true
Unit=tala@post-denys.service

[Install]
WantedBy=timers.target
