[Unit]
Description=tala post tick (hourly; self-throttle gives ~every 2h)

[Timer]
# Checked hourly at :07; run_pipeline(--tick) only posts if >TALA_MIN_GAP_MINUTES
# since the last post, so the effective cadence is ~2h and a missed hour catches up.
OnCalendar=*-*-* *:07:00
Persistent=true
Unit=tala@post-tala.service

[Install]
WantedBy=timers.target
