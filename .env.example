# Copy to .env and fill in. The .env file is git-ignored.

ANTHROPIC_API_KEY=
WRITER_MODEL=claude-sonnet-4-20250514

# Threads Graph API — long-lived access token for the target account (@tala.sav).
# Get one via the Meta app that owns the account; check identity with:
#   curl "https://graph.threads.net/v1.0/me?fields=username&access_token=<TOKEN>"
# Long-lived tokens last 60 days; refresh before expiry:
#   curl "https://graph.threads.net/v1.0/refresh_access_token?grant_type=th_refresh_token&access_token=<TOKEN>"
THREADS_ACCESS_TOKEN=

# Long-lived Threads token for the @blacksea brand account (first-run seed only;
# afterwards it lives in Supabase blacksea_token and auto-refreshes).
BLACKSEA_THREADS_ACCESS_TOKEN=

# Optional: how often blacksea leans on a multi-post chain vs a single post.
# Default 0.2 (mostly single friendly posts). Tala's equivalent is CHAIN_PROBABILITY.
# BLACKSEA_CHAIN_PROBABILITY=0.2

# Optional images. Point this at a PUBLIC manifest file (e.g. on Cloudflare R2)
# that lists image URLs — a JSON array, a {"images":[...]} object, or one URL per
# line. The pipeline attaches a RANDOM image to a Tala post with probability
# TALA_IMAGE_PROBABILITY (default 0.35 ≈ every 3rd post). Empty manifest = text-only.
# TALA_IMAGE_MANIFEST_URL=https://img.example.com/tala/manifest.json
# TALA_IMAGE_PROBABILITY=0.35
# BLACKSEA_IMAGE_MANIFEST_URL=
# BLACKSEA_IMAGE_PROBABILITY=0

# Optional self-throttle: minimum minutes between published posts per brand. The
# cron fires every 30 min; the pipeline skips a tick if the last post is newer
# than this, so dropped/late GitHub runs are caught by the next slot.
# POST_MIN_GAP_MINUTES=115        # tala  -> ~every 2h
# BLACKSEA_MIN_GAP_MINUTES=210    # blacksea -> ~3-4 posts/day in the 06-19 UTC window

# Commenting (tala replies under other people's posts). Min minutes between
# comments; the scraper must keep tala_comment_targets populated by keyword.
# COMMENT_MIN_GAP_MINUTES=90

# Threads parser session (parser/scraper.py). Defaults to parser/scout_session.json.
# THREADS_SESSION_FILE=

POST_INTERVAL_HOURS=1
LOG_LEVEL=INFO

# Proxy for the web-UI automation (scraper + Tala commenting) — the flaggable
# part that runs from the datacenter IP. Posting uses the official API and is
# unaffected. Full URL or host:port. Leave empty to go direct.
#   SCRAPER_PROXY=http://user:pass@gate.provider.com:8000
SCRAPER_PROXY=

# Denys browser session for commenting — replies are published as whoever this
# cookie jar is logged in as, so it MUST be a @den.bilyy session (not the scraper
# one). Create it locally: python -m parser.scraper --login  (log in as den.bilyy)
# then copy the JSON to the server as parser/denys_session.json
# DENYS_SESSION_FILE=
# DENYS_COMMENT_MIN_GAP_MINUTES=180

# X (Twitter) per brand, OAuth 1.0a user context (POST /2/tweets rejects
# app-only bearer tokens; these tokens do not expire). Create the app at
# developer.x.com, then generate the ACCOUNT access token/secret with Read+Write.
# X billing is pay-per-use since Feb 2026: ~$0.015/post, ~$0.20 if it has a URL —
# so keep links in bio, not in the post text. Buy credits in the Developer Console.
# X_<BRAND>_API_KEY=
# X_<BRAND>_API_SECRET=
# X_<BRAND>_ACCESS_TOKEN=
# X_<BRAND>_ACCESS_SECRET=
