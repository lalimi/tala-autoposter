[Unit]
Description=blacksea post tick (every ~2-3h, randomised)

[Timer]
# Checked hourly 05-22 UTC (08:00-01:00 Kyiv). The pipeline draws a fresh
# gap of 2h15m-2h50m per tick, so this yields ~6-7 posts a day at irregular
# times. Measured reach still peaks 21:00-01:00 Kyiv; daytime slots are the
# weaker ones and exist for volume, not for reach.
OnCalendar=*-*-* 05..22:13:00
# Fire up to 15 min off the scheduled minute.
RandomizedDelaySec=900
Persistent=true
Unit=tala@post-blacksea.service

[Install]
WantedBy=timers.target
